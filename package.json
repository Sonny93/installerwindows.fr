	"type": "module",
	"imports": {
		"#client/*": "./.adonisjs/client/*.ts",
		"#generated/*": "./.adonisjs/server/*.js",
		"#guides/*": "./app/guides/*.js",
		"#videos/*": "./app/videos/*.js",
		"#auth/*": "./app/auth/*.js",
		"#home/*": "./app/home/*.js",
		"#cgu/*": "./app/cgu/*.js",
		"#status/*": "./app/status/*.js",
		"#markdown/*": "./app/markdown/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#models/*": "./app/models/*.js",
		"#mails/*": "./app/mails/*.js",
		"#libs/*": "./app/libs/*.js",
		"#listeners/*": "./app/listeners/*.js",
		"#events/*": "./app/events/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#providers/*": "./providers/*.js",
		"#policies/*": "./app/policies/*.js",
		"#abilities/*": "./app/abilities/*.js",
		"#database/*": "./database/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js"
	},
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build --tsconfig tsconfig.build.json",
		"dev": "node ace serve --hmr",
		"test": "node ace test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt && oxlint --fix",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
		"release": "release-it",
		"postinstall": "oxfmt",
		"postuninstall": "oxfmt"
	},
