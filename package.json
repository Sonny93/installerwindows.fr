{
	"name": "new-installerwindows.fr",
	"version": "3.4.0",
	"author": {
		"name": "Sonny",
		"email": "sonnyasdev@gmail.com",
		"url": "https://www.sonny.dev/"
	},
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build",
		"dev": "node ace serve --hmr",
		"test": "node ace test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
		"check": "pnpm run lint && pnpm run typecheck",
		"release": "release-it",
		"postinstall": "pnpm run format",
		"postuninstall": "pnpm run format"
	},
	"imports": {
		"#client/*": "./.adonisjs/client/*.ts",
		"#generated/*": "./.adonisjs/server/*.js",
		"#transformers/*": "./app/transformers/*.js",
		"#controllers/*": "./app/controllers/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#models/*": "./app/models/*.js",
		"#mails/*": "./app/mails/*.js",
		"#services/*": "./app/services/*.js",
		"#libs/*": "./app/libs/*.js",
		"#listeners/*": "./app/listeners/*.js",
		"#events/*": "./app/events/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#validators/*": "./app/validators/*.js",
		"#providers/*": "./providers/*.js",
		"#policies/*": "./app/policies/*.js",
		"#abilities/*": "./app/abilities/*.js",
		"#database/*": "./database/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js",
		"#shared/*": "./shared/*.js"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^8.5.2",
		"@adonisjs/eslint-config": "^3.1.0",
		"@adonisjs/tsconfig": "^2.0.0",
		"@japa/assert": "^4.2.0",
		"@japa/plugin-adonisjs": "^5.2.0",
		"@japa/runner": "^5.3.0",
		"@poppinss/ts-exec": "^1.4.4",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/luxon": "^3.7.5",
		"@types/node": "24",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unocss/preset-icons": "^66.10.5",
		"@unocss/preset-typography": "^66.10.5",
		"@unocss/preset-web-fonts": "^66.10.5",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.11.0",
		"hot-hook": "^1.0.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.9",
		"release-it": "^21.1.0",
		"typescript": "~5.9.3",
		"unocss": "^66.10.5",
		"vite": "^8.3.0",
		"youch": "^4.1.1"
	},
	"dependencies": {
		"@adonisjs/ally": "^6.3.0",
		"@adonisjs/auth": "^10.1.0",
		"@adonisjs/cache": "2.1.0",
		"@adonisjs/core": "^7.5.2",
		"@adonisjs/cors": "^3.0.0",
		"@adonisjs/inertia": "^5.0.1",
		"@adonisjs/lucid": "^22.4.2",
		"@adonisjs/session": "^8.1.0",
		"@adonisjs/shield": "^9.0.0",
		"@adonisjs/static": "^2.0.1",
		"@adonisjs/vite": "^6.0.2",
		"@inertiajs/react": "^3.7.1",
		"@minimalstuff/ui": "^4.0.0",
		"@tuyau/core": "^1.2.2",
		"@vinejs/vine": "^4.4.0",
		"clsx": "^2.1.1",
		"edge.js": "^6.5.1",
		"knex": "3.3.0",
		"luxon": "^3.7.2",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-player": "^3.4.0",
		"reflect-metadata": "^0.2.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"hotHook": {
		"boundaries": [
			"./app/controllers/**/*.ts",
			"./app/middleware/*.ts"
		]
	},
	"prettier": {
		"trailingComma": "es5",
		"semi": true,
		"singleQuote": true,
		"useTabs": true,
		"quoteProps": "as-needed",
		"bracketSpacing": true,
		"arrowParens": "always",
		"printWidth": 80
	},
	"volta": {
		"node": "24.14.0"
	}
}
