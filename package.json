		"@poppinss/ts-exec": "^1.5.1",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/hast": "^3.0.5",
		"@types/luxon": "^3.7.6",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
