# Template for .env.test, the environment used by "pnpm test" (node ace test).
# .env.test itself is gitignored (same convention AdonisJS uses for every
# non-.example env file) because it carries a throwaway APP_KEY; copy this
# file to .env.test and fill it in once.
#
# None of the values below are real secrets: GithubService and YoutubeService
# are always swapped for fakes or have their network calls stubbed in tests,
# so DISCORD_*/YOUTUBE_API_KEY are never sent anywhere. Only DB_DATABASE
# matters functionally: it must point at an isolated database, never the dev
# or prod one. Create it with:
#   docker exec app-dev-postgres-1 psql -U root -d app -c 'CREATE DATABASE installerwindows_test;'

# App
TZ=Europe/Paris
PORT=3333
HOST=localhost
LOG_LEVEL=warn
APP_KEY=<generate a throwaway 32-char key, e.g. node ace generate:key>
NODE_ENV=test
# "memory" (not "cookie") is required in tests: the session and auth Japa
# api-client plugins simulate session state through the same in-process
# MemoryStore the app's session middleware uses, so the two only agree on
# what's in the session when the app is also configured to use it.
SESSION_DRIVER=memory

# Database (isolated test database, never the dev one)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=installerwindows_test

# Youtube (never called for real: YoutubeService is swapped/stubbed in every test)
YOUTUBE_API_KEY=test-youtube-api-key
YOUTUBE_PLAYLIST_ID=test-playlist-id

# Discord (never called for real: no test exercises a full Ally network round-trip)
DISCORD_CLIENT_ID=test-discord-client-id
DISCORD_CLIENT_SECRET=test-discord-client-secret
USERS_IDS=257285655388880896

# Umami
UMAMI_URL=
UMAMI_WEBSITE_ID=

# App url
APP_URL=http://localhost:3333
