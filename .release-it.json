{
	"$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
	"hooks": {
		"before:init": [
			"git log --format=%s $(git describe --tags --abbrev=0)..HEAD | grep -qE '^(feat|fix|perf|revert)(\\(.+\\))?!?:|^[a-z]+(\\(.+\\))?!:' || (echo 'No releasable commit since the last tag' && exit 1)",
			"pnpm run check",
			"pnpm run build"
		]
	},
	"git": {
		"requireCleanWorkingDir": true,
		"commitMessage": "chore: release v${version}",
		"commit": true,
		"tag": true,
		"push": true
	},
	"github": {
		"release": true,
		"web": true
	},
	"npm": {
		"publish": false
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"context": {
				"host": "https://github.com",
				"owner": "Sonny93",
				"repository": "installerwindows.fr"
			},
			"infile": "CHANGELOG.md",
			"preset": {
				"name": "conventionalcommits"
			}
		}
	}
}
